#!/bin/sh
# Blocks a commit when the content data points at files that do not exist, or
# when a case study's `updated` date no longer matches git (so the sitemap's
# <lastmod> values cannot silently drift).
# Installed automatically by `npm install` / `npm ci` (scripts/install-git-hooks.sh).
set -e
node "$(git rev-parse --show-toplevel)/scripts/check-content.mjs"
exec node "$(git rev-parse --show-toplevel)/scripts/update-lastmod.mjs" --check
